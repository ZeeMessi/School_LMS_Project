@page
@model SchoolLMS.Pages.GradeModel

@{
    ViewData["Title"] = "Grade";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Grade.css" asp-append-version="true" />
}

<div class="grade-page">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="grade-page-header">
        <div>
            <span class="grade-page-icon">📊</span>
            <div>
                <h1>Grade</h1>
                <p>Academic performance and examination results</p>
            </div>
        </div>
    </div>


    <!-- ============================================================
         STUDENT INFORMATION
         Database-ready: values can later come from the database.
         ============================================================ -->

    <section class="grade-student-card">

        <div class="grade-profile-placeholder">
            @if (Model.HasPhoto)
            {
                <img src="/image/student/@Model.StudentId" alt="@Model.StudentName" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
            }
            else
            {
                <span>PHOTO</span>
            }
        </div>

        <div class="grade-student-info">

            <div class="grade-student-name">
                @Model.StudentName
            </div>

            <div class="grade-student-meta">
                <span>Roll No: @Model.RollNumber</span>
                <span>Class: @Model.ClassName</span>
                <span>Section: @Model.SectionName</span>
                <span>Academic Year: @Model.AcademicYear</span>
            </div>

        </div>

    </section>


    <!-- ============================================================
         PERFORMANCE SUMMARY
         ============================================================ -->

    <section class="grade-summary-grid">

        <div class="grade-summary-card percentage-card">
            <div class="summary-icon">%</div>
            <div>
                <span class="summary-label">Overall Percentage</span>
                <strong id="overallPercentage">@Model.OverallPercentage.ToString("0.#")%</strong>
            </div>
        </div>

        <div class="grade-summary-card">
            <div class="summary-icon">★</div>
            <div>
                <span class="summary-label">Overall Grade</span>
                <strong id="overallGrade">@Model.OverallGrade</strong>
            </div>
        </div>

        <div class="grade-summary-card">
            <div class="summary-icon">✓</div>
            <div>
                <span class="summary-label">Total Marks</span>
                <strong id="totalMarks">@Model.TotalObtainedMarks / @Model.TotalMaxMarks</strong>
            </div>
        </div>

        <div class="grade-summary-card">
            <div class="summary-icon">✓</div>
            <div>
                <span class="summary-label">Subjects Passed</span>
                <strong id="subjectsPassed">@Model.SubjectsPassed / @Model.SubjectsCount</strong>
            </div>
        </div>

    </section>


    <!-- ============================================================
         EXAMINATION SELECTOR
         ============================================================ -->

    <section class="grade-section">

        <div class="section-heading">
            <div>
                <h2>Examination</h2>
                <p>Select an examination to view results.</p>
            </div>
        </div>

        <div class="exam-selector">

            @foreach (var examType in Model.AvailableExamTypes)
            {
                <a class="exam-button @(examType.IsActive ? "active" : "")"
                   href="?examCode=@examType.Code">
                    @examType.Name
                </a>
            }

        </div>

    </section>


    <!-- ============================================================
         INTERACTIVE PERFORMANCE CHART
         ============================================================ -->

    <section class="grade-section">

        <div class="section-heading">
            <div>
                <h2>Subject Performance</h2>
                <p>Compare your performance across subjects.</p>
            </div>

            <div class="chart-legend">
                <span class="legend-dot"></span>
                Percentage
            </div>
        </div>

        <div class="performance-chart-card">

            <div class="chart-area" id="performanceChart">

                @foreach (var result in Model.SubjectResults)
                {
                    <div class="chart-column">
                        <div class="chart-bar" style="--bar-height: @(result.Percentage)%;">
                            <span class="chart-percentage">@result.Percentage.ToString("0")%</span>
                            <div class="chart-tooltip">
                                <strong>@result.Subject</strong><br />
                                Marks: @result.ObtainedMarks/@result.TotalMarks<br />
                                Percentage: @result.Percentage.ToString("0")%<br />
                                Grade: @result.Grade
                            </div>
                        </div>
                        <span class="chart-subject">@result.Subject</span>
                    </div>
                }

            </div>

        </div>

    </section>


    <!-- ============================================================
         SUBJECT RESULTS
         ============================================================ -->

    <section class="grade-section">

        <div class="section-heading">
            <div>
                <h2>Subject Results</h2>
                <p>Detailed examination results.</p>
            </div>
        </div>

        <div class="grade-table-wrapper">

            <table class="grade-table">

                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Total Marks</th>
                        <th>Obtained</th>
                        <th>Percentage</th>
                        <th>Grade</th>
                        <th>Remarks</th>
                    </tr>
                </thead>

                <tbody id="gradeTableBody">

                    @if (Model.SubjectResults.Count == 0)
                    {
                        <tr>
                            <td colspan="6">No results recorded for this examination yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var result in Model.SubjectResults)
                        {
                            <tr data-subject="@result.Subject"
                                data-marks="@result.ObtainedMarks"
                                data-total="@result.TotalMarks"
                                data-grade="@result.Grade">
                                <td>@result.Subject</td>
                                <td>@result.TotalMarks</td>
                                <td>@result.ObtainedMarks</td>
                                <td>@result.Percentage.ToString("0.#")%</td>
                                <td>
                                    <span class="grade-badge @result.GradeCssClass">@result.Grade</span>
                                </td>
                                <td>@result.Remarks</td>
                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </section>


    <!-- ============================================================
         PERFORMANCE HISTORY
         ============================================================ -->

    <section class="grade-section">

        <div class="section-heading">
            <div>
                <h2>Performance History</h2>
                <p>Track academic progress across examinations.</p>
            </div>
        </div>

        <div class="history-card">

            <div class="history-chart" id="historyChart">

                @if (Model.PerformanceHistory.Count == 0)
                {
                    <p>No exam history recorded yet.</p>
                }
                else
                {
                    @foreach (var point in Model.PerformanceHistory)
                    {
                        <div class="history-column">
                            <div class="history-point" title="@point.ExamTypeName: @point.AveragePercentage%">
                                <span class="history-value">@point.AveragePercentage%</span>
                            </div>
                            <span class="history-label">@point.ExamTypeName</span>
                        </div>
                    }
                }

            </div>

        </div>

    </section>


    <!-- ============================================================
         GRADE SCALE
         ============================================================ -->

    <section class="grade-section">

        <div class="section-heading">
            <div>
                <h2>Grade Scale</h2>
                <p>Current grading criteria.</p>
            </div>
        </div>

        <div class="grade-scale-grid">

            <div class="scale-item">
                <strong>A+</strong>
                <span>90–100%</span>
            </div>

            <div class="scale-item">
                <strong>A</strong>
                <span>80–89%</span>
            </div>

            <div class="scale-item">
                <strong>B+</strong>
                <span>75–79%</span>
            </div>

            <div class="scale-item">
                <strong>B</strong>
                <span>70–74%</span>
            </div>

            <div class="scale-item">
                <strong>C+</strong>
                <span>65–69%</span>
            </div>

            <div class="scale-item">
                <strong>C</strong>
                <span>50–64%</span>
            </div>

            <div class="scale-item">
                <strong>F</strong>
                <span>Below 50%</span>
            </div>

        </div>

    </section>


    <!-- ============================================================
         TEACHER REMARKS
         ============================================================ -->

    <section class="grade-section">

        <div class="section-heading">
            <div>
                <h2>Teacher Remarks</h2>
                <p>Comments regarding academic performance.</p>
            </div>
        </div>

        <!--
            Still a placeholder: there's no TeacherRemark entity yet, so
            this general comment isn't database-backed the way the summary
            cards and table above are. The per-subject Remarks column,
            however, does come from the real ExamResult.Remarks column.
        -->
        <div class="teacher-remark-card">

            <div class="remark-icon">💬</div>

            <div>
                <h3>Class Teacher</h3>

                <p>
                    @(Model.StudentName.Split(' ')[0]) has shown good progress overall
                    this term. See the subject remarks above for details on
                    individual subjects.
                </p>
            </div>

        </div>

    </section>

</div>


@* Grade.js was removed - it used to overwrite this entire page's
   server-rendered content with its own separate hardcoded dataset on
   load, which would have silently defeated everything above. Now that
   the table, chart, and history are all rendered server-side from real
   data, there's no client-side rendering left to do here. *@