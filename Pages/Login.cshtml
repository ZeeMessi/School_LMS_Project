@page
@model SchoolLMS.Pages.LoginModel
@{
    // Layout = null means this page ignores the shared _Layout.cshtml (with its
    // default Bootstrap nav bar) and is fully self-contained. Useful while we
    // build pages one at a time — we'll wire up a real shared layout later.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - School LMS</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <main class="login-wrapper">
        <div class="login-card">

            <div class="login-header">
                <div class="logo-placeholder">SL</div>
                <h1 class="school-name">Your School Name</h1>
                <p class="system-name">Learning Management System</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="login-error" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" class="login-form">

                <div class="form-group">
                    <label for="Username">Username</label>
                    <input type="text" id="Username" name="Username" value="@Model.Username" placeholder="Enter your username" autocomplete="username" required autofocus />
                </div>

                <div class="form-group">
                    <label for="Password">Password</label>
                    <div class="password-field">
                        <input type="password" id="Password" name="Password" placeholder="Enter your password" autocomplete="current-password" required />
                        <button type="button" id="togglePassword" class="toggle-password" aria-label="Show password">
                            <svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20">
                                <path fill="currentColor" d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 110-10 5 5 0 010 10zm0-8a3 3 0 100 6 3 3 0 000-6z"/>
                            </svg>
                            <svg id="eyeClosed" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" style="display:none;">
                                <path fill="currentColor" d="M2 4.27L3.28 3 21 20.72 19.73 22l-3.08-3.08A11.6 11.6 0 0112 19c-7 0-10-7-10-7a17.6 17.6 0 014.06-5.44L2 4.27zM12 7a5 5 0 015 5c0 .6-.12 1.16-.33 1.67l-1.6-1.6A3 3 0 0012 9c-.24 0-.47.03-.68.08l-1.6-1.6C10.3 7.17 11.1 7 12 7zm0 10c1.4 0 2.6-.24 3.66-.65l-1.5-1.5A5 5 0 017.15 9.83l-1.5-1.5C4.62 9.4 4 10.1 3.5 11c0 0 3 7 10 7z"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <a href="/ForgotPassword" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="sign-in-btn">Sign In</button>

            </form>
        </div>
    </main>

    <script src="~/js/login.js"></script>
</body>
</html>