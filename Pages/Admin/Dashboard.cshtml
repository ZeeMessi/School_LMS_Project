@page
@model SchoolLMS.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="portal-card">
    <h2>@Model.SchoolName</h2>
    <p>
        Manage the school's students, teachers, classes, and fee invoices
        from the links on the left.
    </p>
    <div class="portal-class-actions">
        <a class="portal-button" href="/Admin/Students">Students</a>
        <a class="portal-button" href="/Admin/Teachers">Teachers</a>
        <a class="portal-button" href="/Admin/Classes">Classes</a>
        <a class="portal-button" href="/Admin/Fees">Fees</a>
    </div>
</div>

<div class="portal-summary-grid">

    <div class="portal-summary-card">
        <strong>@Model.StudentCount</strong>
        <span>Students</span>
    </div>

    <div class="portal-summary-card">
        <strong>@Model.TeacherCount</strong>
        <span>Teachers</span>
    </div>

    <div class="portal-summary-card">
        <strong>@Model.ClassCount</strong>
        <span>Classes</span>
    </div>

</div>
