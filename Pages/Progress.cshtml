@page
@model SchoolLMS.Pages.ProgressModel
@{
    ViewData["Title"] = "Progress";
}

<link rel="stylesheet" href="~/css/Progress.css" />

<div class="progress-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="progress-page-header">

        <div class="progress-title-area">

            <div class="progress-title-icon">
                📈
            </div>

            <div>
                <h1>Progress</h1>
                <p>Track academic performance and improvement over time</p>
            </div>

        </div>

        <div class="progress-student-info">

            <span class="progress-class-badge">
                @Model.ClassLabel
            </span>

            <span class="progress-year-badge">
                @Model.AcademicYear
            </span>

        </div>

    </div>


    <!-- =========================================================
         FILTERS

         Academic Year / Term / Period were dropped: there's no Term
         entity in the schema and only one real academic year exists,
         so those were decorative dropdowns that changed nothing.
         Subject is real - it's a genuine dimension of ExamResult data
         and actually filters the charts below via a page reload.
         ========================================================= -->

    <div class="progress-filter-card">

        <form method="get" class="progress-filter">

            <label for="progressSubject">
                Subject
            </label>

            <select id="progressSubject" name="Subject" onchange="this.form.submit()">
                <option value="All" selected="@(Model.Subject == "All" ? "selected" : null)">All Subjects</option>
                @foreach (var subject in Model.AvailableSubjects)
                {
                    <option value="@subject" selected="@(Model.Subject == subject ? "selected" : null)">@subject</option>
                }
            </select>

        </form>

    </div>


    @if (Model.Sittings.Count == 0)
    {
        <div class="progress-main-card">
            <div class="progress-card-header">
                <div>
                    <h2>No results recorded yet</h2>
                    <p>
                        Progress is calculated from exam results and attendance -
                        once at least one examination has been graded, this page
                        will show real trends here.
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- =========================================================
             SUMMARY CARDS
             ========================================================= -->

        <div class="progress-summary-grid">

            <div class="progress-summary-card">

                <div class="summary-icon blue">
                    📊
                </div>

                <div class="summary-content">

                    <span class="summary-label">
                        Overall Progress
                    </span>

                    <strong id="overallProgress">
                        @Model.OverallPercentage?.ToString("0.#")%
                    </strong>

                    <small>
                        @Model.ProgressStatus
                    </small>

                </div>

            </div>


            <div class="progress-summary-card">

                <div class="summary-icon green">
                    📈
                </div>

                <div class="summary-content">

                    <span class="summary-label">
                        Improvement
                    </span>

                    @if (Model.ImprovementPercentage is { } improvement)
                    {
                        <strong>@(improvement >= 0 ? "+" : "")@improvement.ToString("0.#")%</strong>
                        <small class="@(improvement >= 0 ? "summary-positive" : "")">
                            @(improvement >= 0 ? "Improving" : "Declining")
                        </small>
                    }
                    else
                    {
                        <strong>—</strong>
                        <small>Not enough data yet</small>
                    }

                </div>

            </div>


            <div class="progress-summary-card">

                <div class="summary-icon purple">
                    🏆
                </div>

                <div class="summary-content">

                    <span class="summary-label">
                        Current Grade
                    </span>

                    <strong>
                        @Model.OverallGrade
                    </strong>

                    <small>
                        @Model.ProgressStatus
                    </small>

                </div>

            </div>


            <div class="progress-summary-card">

                <div class="summary-icon orange">
                    🎯
                </div>

                <div class="summary-content">

                    <span class="summary-label">
                        Subjects Improving
                    </span>

                    @if (Model.SubjectsComparableCount > 0)
                    {
                        <strong>@Model.SubjectsImprovingCount / @Model.SubjectsComparableCount</strong>
                        <small>
                            @(Model.SubjectsComparableCount - Model.SubjectsImprovingCount) need attention
                        </small>
                    }
                    else
                    {
                        <strong>—</strong>
                        <small>Not enough data yet</small>
                    }

                </div>

            </div>

        </div>


        <!-- =========================================================
             PERFORMANCE TREND
             ========================================================= -->

        <div class="progress-main-card">

            <div class="progress-card-header">

                <div>

                    <h2>
                        Performance Over Time
                    </h2>

                    <p>
                        @(Model.Subject == "All" ? "Overall" : Model.Subject) performance across each examination sat so far
                    </p>

                </div>

            </div>

            @if (Model.Sittings.Count < 2)
            {
                <p style="padding: 20px; color: #64748b;">
                    Only one examination on record so far - a trend line needs at least two.
                </p>
            }

            <div class="progress-line-chart-container">

                <canvas id="performanceTrendChart"></canvas>

            </div>

        </div>


        <!-- =========================================================
             SUBJECT PERFORMANCE + ASSESSMENT BREAKDOWN
             ========================================================= -->

        <div class="progress-two-column">


            <!-- SUBJECT PERFORMANCE -->

            <div class="progress-main-card">

                <div class="progress-card-header">

                    <div>

                        <h2>
                            Subject Progress
                        </h2>

                        <p>
                            Current performance by subject
                        </p>

                    </div>

                </div>

                <div class="subject-progress-list">

                    @foreach (var subject in Model.SubjectProgress)
                    {
                        <div class="subject-progress-item">

                            <div class="subject-progress-top">
                                <span>@subject.Subject</span>
                                <strong>@subject.LatestPercentage.ToString("0.#")%</strong>
                            </div>

                            <div class="subject-progress-track">
                                <div
                                    class="subject-progress-fill"
                                    style="width: @(subject.LatestPercentage.ToString("0.#"))%;">
                                </div>
                            </div>

                            @if (subject.Delta is { } delta)
                            {
                                <small class="@(delta >= 0 ? "progress-up" : "progress-down")">
                                    @(delta >= 0 ? "↑" : "↓") @Math.Abs(delta).ToString("0.#")% @(delta >= 0 ? "improvement" : "decline")
                                </small>
                            }
                            else
                            {
                                <small>First recorded result</small>
                            }

                        </div>
                    }

                </div>

            </div>


            <!-- ASSESSMENT BREAKDOWN -->

            <div class="progress-main-card">

                <div class="progress-card-header">

                    <div>

                        <h2>
                            Assessment Breakdown
                        </h2>

                        <p>
                            Performance across each examination type
                        </p>

                    </div>

                </div>

                <div class="assessment-chart-container">

                    <canvas id="assessmentChart"></canvas>

                </div>

            </div>

        </div>


        <!-- =========================================================
             ATTENDANCE VS ACADEMIC PERFORMANCE
             ========================================================= -->

        <div class="progress-main-card">

            <div class="progress-card-header">

                <div>

                    <h2>
                        Attendance &amp; Academic Progress
                    </h2>

                    <p>
                        Comparison between attendance and academic performance, by month
                    </p>

                </div>

            </div>

            @if (Model.AttendanceVsPerformance.Count == 0)
            {
                <p style="padding: 20px; color: #64748b;">No attendance or exam data recorded yet.</p>
            }
            else
            {
                <div class="attendance-chart-container">

                    <canvas id="attendancePerformanceChart"></canvas>

                </div>
            }

        </div>


        <!-- =========================================================
             STRENGTHS + AREAS NEEDING ATTENTION
             ========================================================= -->

        <div class="progress-two-column">


            <!-- STRENGTHS -->

            <div class="progress-main-card strengths-card">

                <div class="progress-card-header">

                    <div>

                        <h2>
                            ⭐ Strengths
                        </h2>

                        <p>
                            Subjects where the student is performing strongly
                        </p>

                    </div>

                </div>

                <div class="strength-list">

                    @if (Model.Strengths.Count == 0)
                    {
                        <p style="padding: 10px 0; color: #64748b;">No standout subjects yet.</p>
                    }

                    @foreach (var strength in Model.Strengths)
                    {
                        <div class="strength-item">

                            <span class="strength-icon">
                                ✓
                            </span>

                            <div>

                                <strong>
                                    @strength.Subject
                                </strong>

                                <small>
                                    @strength.Percentage.ToString("0.#")% — @strength.Note
                                </small>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- NEEDS ATTENTION -->

            <div class="progress-main-card attention-card">

                <div class="progress-card-header">

                    <div>

                        <h2>
                            ⚠ Areas Needing Attention
                        </h2>

                        <p>
                            Subjects where additional attention may help
                        </p>

                    </div>

                </div>

                <div class="attention-list">

                    @if (Model.NeedsAttention.Count == 0)
                    {
                        <p style="padding: 10px 0; color: #64748b;">Nothing needs attention right now.</p>
                    }

                    @foreach (var attention in Model.NeedsAttention)
                    {
                        <div class="attention-item">

                            <span class="attention-icon">
                                !
                            </span>

                            <div>

                                <strong>
                                    @attention.Subject
                                </strong>

                                <small>
                                    @attention.Percentage.ToString("0.#")% — @attention.Note
                                </small>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- =========================================================
             PROGRESS TIMELINE
             ========================================================= -->

        <div class="progress-main-card">

            <div class="progress-card-header">

                <div>

                    <h2>
                        Progress Timeline
                    </h2>

                    <p>
                        Every examination completed so far
                    </p>

                </div>

            </div>


            <div class="progress-timeline">

                @for (var i = 0; i < Model.Timeline.Count; i++)
                {
                    var entry = Model.Timeline[i];

                    <div class="timeline-item @(i == Model.Timeline.Count - 1 ? "timeline-current" : "")">

                        <div class="timeline-dot"></div>

                        <div class="timeline-content">

                            <span class="timeline-date">
                                @entry.Date.ToString("MMMM yyyy")
                            </span>

                            <h3>
                                @entry.Title
                            </h3>

                            <p>
                                @entry.Description
                            </p>

                        </div>

                    </div>
                }

            </div>

        </div>
    }


    <!-- =========================================================
         FOOTER NOTE
         ========================================================= -->

    <div class="progress-footer-note">

        <span>ℹ</span>

        <p>
            Progress is calculated from real exam results and attendance
            records - there is nothing hardcoded on this page.
        </p>

    </div>

</div>


@section Scripts {

    <!-- Chart library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- The real data behind the two charts above - read by Progress.js
         instead of the hardcoded arrays it used to contain. -->
    <script type="application/json" id="progress-data">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            trend = new
            {
                labels = Model.Sittings.Select(s => s.ExamTypeName),
                values = Model.Sittings.Select(s => s.Percentage)
            },
            attendanceVsPerformance = new
            {
                labels = Model.AttendanceVsPerformance.Select(m => m.MonthLabel),
                attendance = Model.AttendanceVsPerformance.Select(m => m.AttendancePercentage),
                academic = Model.AttendanceVsPerformance.Select(m => m.AcademicPercentage)
            }
        }))
    </script>

    <!-- Progress page JavaScript -->
    <script src="~/js/Progress.js"></script>
}
