@page
@model SchoolLMS.Pages.Admin.Teachers.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Teacher" : "Edit Teacher";
}

<div class="portal-card">
    <h2>@(Model.IsNew ? "Add Teacher" : "Edit Teacher")</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="login-error">@Model.ErrorMessage</div>
    }

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="portal-field-row" style="align-items:center;">
            <div class="portal-field">
                <label>Current Photo</label>
                @if (Model.HasPhoto)
                {
                    <img src="/image/teacher/@Model.Id" alt="@Model.FullName" style="width:56px;height:56px;object-fit:cover;border-radius:50%;border:1px solid #e2e8f0;" />
                }
                else
                {
                    <img src="@Model.PlaceholderAvatarUri" alt="Placeholder avatar" style="width:56px;height:56px;object-fit:cover;border-radius:50%;" />
                    <br />
                    <small style="color:#64748b;">No photo uploaded - showing a placeholder based on gender</small>
                }
            </div>

            <div class="portal-field">
                <label asp-for="Photo">Upload New Photo (JPEG/PNG/WebP/GIF, max 2 MB)</label>
                <input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
            </div>
        </div>

        <div class="portal-field-row">
            <div class="portal-field">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" />
            </div>

            <div class="portal-field">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" autocomplete="off" />
            </div>

            <div class="portal-field">
                <label asp-for="Gender">Gender</label>
                <select asp-for="Gender">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
        </div>

        <div class="portal-field-row">
            <div class="portal-field">
                <label asp-for="ContactNumber">Contact Number</label>
                <input asp-for="ContactNumber" />
            </div>

            <div class="portal-field">
                <label asp-for="BloodGroup">Blood Group</label>
                <select asp-for="BloodGroup">
                    <option value="">Not specified</option>
                    @foreach (var option in Model.BloodGroupOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
            </div>

            <div class="portal-field">
                <label asp-for="CnicNumber">CNIC Number</label>
                <input asp-for="CnicNumber" placeholder="XXXXX-XXXXXXX-X" />
            </div>
        </div>

        <div class="portal-field-row">
            <div class="portal-field" style="flex:1;min-width:260px;">
                <label asp-for="Address">Address (English, Urdu or numbers)</label>
                <input asp-for="Address" style="width:100%;" lang="ur" dir="auto" />
            </div>
        </div>

        <div class="portal-field-row">
            <div class="portal-field">
                <label asp-for="Password">
                    @(Model.IsNew ? "Password" : "New Password (leave blank to keep current)")
                </label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
            </div>
        </div>

        <p style="color:#64748b;font-size:13px;">
            Assign this teacher to classes/subjects from the
            <a href="/Admin/Classes">Classes</a> page.
        </p>

        <button type="submit" class="portal-button">Save</button>
        <a href="/Admin/Teachers" class="portal-button secondary">Cancel</a>
    </form>
</div>
