@*
    ============================================================
    SHARED LMS LAYOUT
    ============================================================

    Three main areas:

    1. SIDEBAR
       - School logo
       - Hamburger
       - Navigation icons + names

    2. HEADER
       - LMS
       - Learning Management System
       - Notification
       - Student information
       - Profile picture

    3. MAIN CONTENT
       - Future Class, Attendance, Gradebook, etc.
       - @RenderBody() places the selected page here.
*@

@inject SchoolLMS.Data.AppDbContext Db
@using SchoolLMS.Services
@using Microsoft.EntityFrameworkCore
@{
    // Used below to mark the current page's sidebar link as active,
    // e.g. "/Overview", "/class", "/Attendance".
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    bool IsActive(string page) => currentPage == page;

    // This layout is only ever used by student-facing pages (Teacher/Admin
    // have their own layout), so the logged-in user here is always a
    // student - see Program.cs's AuthorizeFolder and Login.cshtml.cs's
    // role-based redirect after sign-in.
    var studentId = User.GetStudentId();
    var currentStudent = studentId is not null
        ? await Db.Students.FindAsync(studentId)
        : null;

    var studentName = currentStudent?.FullName ?? "";
    var studentRoll = currentStudent?.RollNumber ?? "";
    var studentInitials = string.Concat(
        studentName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpperInvariant(word[0])));

    var hasStudentPhoto = currentStudent?.PhotoData != null;
    var hasSchoolLogo = await Db.Schools.AnyAsync(s => s.LogoData != null);

    // "New content" badges on the sidebar links below and the
    // notification bell - see NavTrackingService for what each flag
    // means and ContentTrackingService for the per-subject flags Class
    // and Overview roll up.
    var navFlags = currentStudent is not null
        ? await NavTrackingService.GetNavFlagsAsync(Db, currentStudent.Id, currentStudent.ClassRoomId)
        : new NavTrackingService.NavFlags();

    var notifications = currentStudent is not null
        ? await NotificationService.GetRecentAsync(Db, currentStudent.Id, currentStudent.ClassRoomId)
        : new List<NotificationService.NotificationItem>();

    string TimeAgo(DateTime timestamp)
    {
        var span = DateTime.UtcNow - timestamp;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return timestamp.ToString("d MMM yyyy");
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - School LMS</title>

    <link rel="stylesheet"
          href="~/css/site.css" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside id="sidebar"
           class="sidebar">

        <!-- SIDEBAR HEADER -->

        <div class="sidebar-header">

            <!--
                OPEN STATE:
                SCHOOL LOGO | HAMBURGER

                CLOSED STATE:
                HAMBURGER ONLY

                The logo is completely removed when collapsed.
            -->

            <div class="school-logo">

                <!--
                    Replace this placeholder later with your
                    actual school logo.

                    The container is intentionally flexible.
                -->

                @if (hasSchoolLogo)
                {
                    <img src="/image/school" alt="School logo" style="max-width:100%;max-height:100%;object-fit:contain;" />
                }
                else
                {
                    <div class="school-logo-placeholder">
                        SCHOOL LOGO
                    </div>
                }

            </div>


            <!-- HAMBURGER -->

            <button id="sidebarToggle"
                    class="sidebar-toggle"
                    type="button"
                    aria-label="Toggle sidebar"
                    aria-expanded="true">

                <span class="hamburger-lines">
                    ☰
                </span>

            </button>

        </div>


        <!-- =================================================
             SIDEBAR NAVIGATION

             To change order later:
             simply move an entire <a> block.

             To add a new option:
             copy one <a> block.
             ================================================= -->

        <nav class="sidebar-navigation">

            <a href="/Overview"
                class="sidebar-link @(IsActive("/Overview") || IsActive("/Index") ? "active" : "")">

            <span class="sidebar-icon-box">
            <span class="sidebar-icon">⌂</span>
            @if (navFlags.Overview)
            {
                <span class="nav-new-badge" title="New"></span>
            }
            </span>

             <span class="sidebar-text">
                Overview
            </span>

            </a>

            <a href="/class"
               class="sidebar-link @(IsActive("/class") ? "active" : "")">

                <span class="sidebar-icon-box">
                    <span class="sidebar-icon">▣</span>
                    @if (navFlags.Class)
                    {
                        <span class="nav-new-badge" title="New"></span>
                    }
                </span>

                <span class="sidebar-text">
                    Class
                </span>

            </a>


            <a href="/Attendance"
               class="sidebar-link @(IsActive("/Attendance") ? "active" : "")">

                <span class="sidebar-icon-box">
                    <span class="sidebar-icon">✓</span>
                </span>

                <span class="sidebar-text">
                    Attendance
                </span>

            </a>


            <a href="/Grade"
               class="sidebar-link @(IsActive("/Grade") ? "active" : "")">

                <span class="sidebar-icon-box">
                    <span class="sidebar-icon">▤</span>
                    @if (navFlags.GradeBook)
                    {
                        <span class="nav-new-badge" title="New"></span>
                    }
                </span>

                <span class="sidebar-text">
                    Grade Book
                </span>

            </a>


            <a href="/Progress"
               class="sidebar-link @(IsActive("/Progress") ? "active" : "")">

                <span class="sidebar-icon-box">
                    <span class="sidebar-icon">↗</span>
                </span>

                <span class="sidebar-text">
                    Progress
                </span>

            </a>


            <a href="/AccountBook"
               class="sidebar-link @(IsActive("/AccountBook") ? "active" : "")">

                <span class="sidebar-icon-box">
                    <span class="sidebar-icon">₨</span>
                    @if (navFlags.AccountBook)
                    {
                        <span class="nav-new-badge" title="New"></span>
                    }
                </span>

                <span class="sidebar-text">
                    Account Book
                </span>

            </a>


            <a href="/ExamSchedule"
               class="sidebar-link @(IsActive("/ExamSchedule") ? "active" : "")">

                <span class="sidebar-icon-box">
                    <span class="sidebar-icon">▦</span>
                    @if (navFlags.ExamSchedule)
                    {
                        <span class="nav-new-badge" title="New"></span>
                    }
                </span>

                <span class="sidebar-text">
                    Exam Schedule
                </span>

            </a>


            <a href="/Announcement"
               class="sidebar-link @(IsActive("/Announcement") ? "active" : "")">

                <span class="sidebar-icon-box">
                    <span class="sidebar-icon">●</span>
                    @if (navFlags.Announcement)
                    {
                        <span class="nav-new-badge" title="New"></span>
                    }
                </span>

                <span class="sidebar-text">
                    Announcements
                </span>

            </a>

        <!-- FEEDBACK -->

            <a href="/Feedback"
            class="sidebar-link @(IsActive("/Feedback") ? "active" : "")">

        <span class="sidebar-icon-box">
        <span class="sidebar-icon">♡</span>
        </span>

        <span class="sidebar-text">
            Feedback
        </span>

        </a>


            <!-- CONTACT -->

        <a href="/Contact"
        class="sidebar-link @(IsActive("/Contact") ? "active" : "")">

        <span class="sidebar-icon-box">
        <span class="sidebar-icon">✉</span>
        </span>

        <span class="sidebar-text">
        Contact
        </span>

        </a>

        </nav>

    </aside>


    <!-- =====================================================
         PAGE AREA
         ===================================================== -->

    <div id="pageArea"
         class="page-area">


        <!-- =================================================
             HEADER
             ================================================= -->

        <header class="top-header">


            <!-- LMS TITLE -->

            <div class="lms-heading">

                <div class="lms-word">
                    LMS
                </div>

                <div class="lms-full-name">
                    Learning Management System
                </div>

            </div>


            <!-- =================================================
                 STUDENT HEADER

                 This is one independent header section.

                 Bell
                 Student Name
                 Roll Number
                 Profile Picture
                 ================================================= -->

            <div class="student-header">


                <!-- NOTIFICATION -->

                <div class="notification-wrapper">

                    <button id="notificationButton"
                            class="notification-button"
                            type="button"
                            aria-label="Notifications"
                            aria-expanded="false">

                        <span class="notification-icon">
                            🔔
                        </span>

                        @if (navFlags.Overview)
                        {
                            <span class="notification-badge-dot" title="New"></span>
                        }

                    </button>

                    <div id="notificationPanel" class="notification-panel" hidden>

                        <div class="notification-panel-header">
                            Notifications
                        </div>

                        @if (notifications.Count == 0)
                        {
                            <div class="notification-empty">
                                Nothing to show yet.
                            </div>
                        }
                        else
                        {
                            @foreach (var item in notifications)
                            {
                                <a href="@item.Url" class="notification-item">
                                    <span class="notification-item-icon">@item.Icon</span>
                                    <span class="notification-item-body">
                                        <span class="notification-item-text">@item.Text</span>
                                        <span class="notification-item-time">@TimeAgo(item.Timestamp)</span>
                                    </span>
                                </a>
                            }
                        }

                    </div>

                </div>


                <!-- STUDENT INFORMATION -->

                <div class="student-details">

                    <span class="student-name">
                        @studentName
                    </span>

                    <span class="student-roll">
                        Roll No: @studentRoll
                    </span>

                </div>


                <!-- PROFILE PICTURE -->

                <div class="profile-picture">

                    @if (hasStudentPhoto)
                    {
                        <img src="/image/student/@studentId" alt="@studentName" />
                    }
                    else
                    {
                        <span class="profile-initials">
                            @studentInitials
                        </span>
                    }

                </div>


                <!-- CHANGE PASSWORD -->

                <a href="/ChangePassword"
                   class="notification-button"
                   title="Change password"
                   aria-label="Change password">
                    🔑
                </a>


                <!-- LOGOUT -->

                <form method="post" asp-page="/Logout">
                    <button type="submit"
                            class="notification-button"
                            title="Log out"
                            aria-label="Log out">
                        ⏻
                    </button>
                </form>


            </div>

        </header>


        <!-- =================================================
             MAIN CONTENT AREA

             Future pages will appear here.

             Example:

             Class
             Attendance
             Gradebook
             Progress
             ================================================= -->

        <main class="main-content">

            @RenderBody()

        </main>


    </div>


    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>