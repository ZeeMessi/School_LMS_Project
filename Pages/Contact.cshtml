@page
@model SchoolLMS.Pages.ContactModel

@{
    ViewData["Title"] = "Contact";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Contact.css" />
}

<div class="contact-page">

    <!-- =====================================================
         SCHOOL HEADER
         ===================================================== -->

    <section class="contact-school-header">

        <div class="contact-school-logo">

            @if (!string.IsNullOrWhiteSpace(Model.SchoolLogo))
            {
                <img src="@Model.SchoolLogo" alt="@Model.SchoolName logo" />
            }
            else
            {
                <div class="contact-logo-placeholder">
                    SCHOOL LOGO
                </div>
            }

        </div>

        <div class="contact-school-name">

            <h1>@Model.SchoolName</h1>

            <p>
                About Us &amp; Contact Us
            </p>

        </div>

    </section>


    <!-- =====================================================
         ABOUT US
         ===================================================== -->

    <section class="contact-card">

        <div class="contact-card-heading">

            <div class="contact-card-icon">
                ℹ
            </div>

            <div>
                <h2>About Us</h2>

                <p>
                    Learn more about our school and our commitment
                    to providing a quality learning environment.
                </p>
            </div>

        </div>

        <div class="contact-about-content">

            <p>
                @Model.AboutUs
            </p>

        </div>

    </section>


    <!-- =====================================================
         CONTACT US
         ===================================================== -->

    <section class="contact-card">

        <div class="contact-card-heading">

            <div class="contact-card-icon">
                ✉
            </div>

            <div>
                <h2>Contact Us</h2>

                <p>
                    Get in touch with the school administration.
                </p>
            </div>

        </div>


        <div class="contact-information-grid">

            <!-- ADDRESS -->

            <div class="contact-information-item">

                <div class="contact-information-icon">
                    📍
                </div>

                <div class="contact-information-content">

                    <span class="contact-label">
                        Address
                    </span>

                    <span class="contact-value">
                        @Model.Address
                    </span>

                </div>

            </div>


            <!-- DIAL -->

            <div class="contact-information-item">

                <div class="contact-information-icon">
                    ☎
                </div>

                <div class="contact-information-content">

                    <span class="contact-label">
                        Dial
                    </span>

                    <span class="contact-value">
                        @Model.Dial
                    </span>

                </div>

            </div>


            <!-- MOBILE -->

            <div class="contact-information-item">

                <div class="contact-information-icon">
                    📱
                </div>

                <div class="contact-information-content">

                    <span class="contact-label">
                        Mobile
                    </span>

                    <span class="contact-value">
                        @Model.Mobile
                    </span>

                </div>

            </div>


            <!-- FAX -->

            <div class="contact-information-item">

                <div class="contact-information-icon">
                    📠
                </div>

                <div class="contact-information-content">

                    <span class="contact-label">
                        Fax
                    </span>

                    <span class="contact-value">
                        @Model.Fax
                    </span>

                </div>

            </div>


            <!-- EMAIL -->

            <div class="contact-information-item">

                <div class="contact-information-icon">
                    ✉
                </div>

                <div class="contact-information-content">

                    <span class="contact-label">
                        Email
                    </span>

                    <span class="contact-value">
                        @Model.Email
                    </span>

                </div>

            </div>

        </div>

    </section>

</div>


@section Scripts {
    <script src="~/js/Contact.js"></script>
}

