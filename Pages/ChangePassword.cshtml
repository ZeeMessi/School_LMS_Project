@page
@model SchoolLMS.Pages.ChangePasswordModel
@using SchoolLMS.Data.Entities
@using SchoolLMS.Services
@{
    // Reachable by every role, each of which normally uses a different
    // shell (_Layout for students, _PortalLayout for Teacher/Admin) - so
    // the layout is picked at render time instead of being fixed.
    Layout = User.GetRole() == UserRole.Student ? "_Layout" : "_PortalLayout";
    ViewData["Title"] = "Change Password";
}
@section Styles {
    @* _Layout.cshtml (the student shell) only loads site.css - the
       portal-* classes this page's markup uses come from portal.css,
       which _PortalLayout.cshtml already loads on its own. Loading it
       again there is a harmless no-op. *@
    <link rel="stylesheet" href="~/css/portal.css" />
}

<div class="portal-card" style="max-width:480px;">
    <h2>Change Password</h2>
    <p>Signed in as <strong>@Model.Username</strong>.</p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="portal-banner">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="login-error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="portal-field">
            <label asp-for="CurrentPassword">Current Password</label>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
        </div>

        <div class="portal-field">
            <label asp-for="NewPassword">New Password</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" />
        </div>

        <div class="portal-field">
            <label asp-for="ConfirmPassword">Confirm New Password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        </div>

        <button type="submit" class="portal-button">Update Password</button>
    </form>
</div>
