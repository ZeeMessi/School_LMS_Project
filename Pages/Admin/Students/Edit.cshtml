@page
@model SchoolLMS.Pages.Admin.Students.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Student" : "Edit Student";
}

<div class="portal-card">
    <h2>@(Model.IsNew ? "Add Student" : "Edit Student")</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="login-error">@Model.ErrorMessage</div>
    }

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="portal-field-row" style="align-items:center;">
            <div class="portal-field">
                <label>Current Photo</label>
                @if (Model.HasPhoto)
                {
                    <img src="/image/student/@Model.Id" alt="@Model.FullName" style="width:56px;height:56px;object-fit:cover;border-radius:50%;border:1px solid #e2e8f0;" />
                }
                else
                {
                    <span style="color:#64748b;">No photo uploaded yet</span>
                }
            </div>

            <div class="portal-field">
                <label asp-for="Photo">Upload New Photo (JPEG/PNG/WebP/GIF, max 2 MB)</label>
                <input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
            </div>
        </div>

        <div class="portal-field-row">
            <div class="portal-field">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" />
            </div>

            <div class="portal-field">
                <label asp-for="RollNumber">Roll Number</label>
                <input asp-for="RollNumber" />
            </div>

            <div class="portal-field">
                <label asp-for="ClassRoomId">Class</label>
                <select asp-for="ClassRoomId">
                    @foreach (var classRoom in Model.ClassRooms)
                    {
                        <option value="@classRoom.Id">@classRoom.ClassName — @classRoom.SectionName</option>
                    }
                </select>
            </div>
        </div>

        <div class="portal-field-row">
            <div class="portal-field">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" autocomplete="off" />
            </div>

            <div class="portal-field">
                <label asp-for="Password">
                    @(Model.IsNew ? "Password" : "New Password (leave blank to keep current)")
                </label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
            </div>
        </div>

        <button type="submit" class="portal-button">Save</button>
        <a href="/Admin/Students" class="portal-button secondary">Cancel</a>
    </form>
</div>
