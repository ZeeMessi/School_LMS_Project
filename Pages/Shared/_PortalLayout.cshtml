@*
    Shared layout for the Teacher and Admin areas. Deliberately separate
    from _Layout.cshtml (the student shell) — a teacher or admin's nav
    doesn't make sense inside the "my own attendance/grades" sidebar built
    for students, so this is its own simple shell instead of overloading
    that one with role-conditional links.
*@
@using SchoolLMS.Data.Entities
@using SchoolLMS.Services
@{
    var role = User.GetRole();
    var username = User.Identity?.Name ?? "";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool IsActive(string page) => currentPage == page;
    bool IsSection(string prefix) => currentPage.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School LMS</title>
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <aside class="portal-sidebar">

        <div class="portal-sidebar-header">
            <span class="portal-brand">LMS</span>
            <span class="portal-role-badge">@role</span>
        </div>

        <nav class="portal-nav">

            @if (role == UserRole.Teacher)
            {
                <a href="/Teacher/Dashboard" class="portal-nav-link @(IsActive("/Teacher/Dashboard") ? "active" : "")">
                    ⌂ Dashboard
                </a>
                <a href="/Teacher/Announcements" class="portal-nav-link @(IsActive("/Teacher/Announcements") ? "active" : "")">
                    📣 Announcements
                </a>
            }

            @if (role == UserRole.Admin)
            {
                <a href="/Admin/Dashboard" class="portal-nav-link @(IsActive("/Admin/Dashboard") ? "active" : "")">
                    ⌂ Dashboard
                </a>
                <a href="/Admin/Students" class="portal-nav-link @(IsSection("/Admin/Students") ? "active" : "")">
                    🎓 Students
                </a>
                <a href="/Admin/Teachers" class="portal-nav-link @(IsSection("/Admin/Teachers") ? "active" : "")">
                    🧑‍🏫 Teachers
                </a>
                <a href="/Admin/Classes" class="portal-nav-link @(IsSection("/Admin/Classes") ? "active" : "")">
                    🏫 Classes
                </a>
                <a href="/Admin/Fees" class="portal-nav-link @(IsSection("/Admin/Fees") ? "active" : "")">
                    💳 Fees
                </a>
                <a href="/Admin/Exams" class="portal-nav-link @(IsSection("/Admin/Exams") ? "active" : "")">
                    🗓️ Exam Schedule
                </a>
                <a href="/Admin/Feedback" class="portal-nav-link @(IsSection("/Admin/Feedback") ? "active" : "")">
                    💬 Feedback
                </a>
                <a href="/Admin/School" class="portal-nav-link @(IsSection("/Admin/School") ? "active" : "")">
                    🏷️ School
                </a>
            }

        </nav>

    </aside>

    <div class="portal-main">

        <header class="portal-header">
            <span class="portal-header-title">@ViewData["Title"]</span>

            <div class="portal-header-user">
                <span class="portal-username">@username</span>

                <form method="post" asp-page="/Logout">
                    <button type="submit" class="portal-logout-button">Log out</button>
                </form>
            </div>
        </header>

        <main class="portal-content">
            @RenderBody()
        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
