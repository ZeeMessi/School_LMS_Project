@page
@model SchoolLMS.Pages.HomeModel
@{
Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home - School LMS</title>
    <link rel="stylesheet" href="~/css/home.css" />
</head>

<body>

 
<header class="top-header">

    <button class="hamburger-btn" id="hamburgerBtn" aria-label="Toggle menu">
        &#9776;
    </button>

    <h1 class="app-title">LEARNING MANAGEMENT SYSTEM</h1>

    <div class="header-right">

        <button class="icon-btn" aria-label="Notifications">
            &#128276;
        </button>

        <div class="student-info">
            <span class="student-name">@Model.StudentName</span>
            <span class="student-roll">@Model.RollNumber</span>
        </div>

        <div class="profile-picture">
            @Model.StudentInitials
        </div>

    </div>

</header>

<aside class="sidebar open" id="sidebar">

    <nav class="sidebar-nav">

        <a href="/Home" class="sidebar-link active">
            <span class="sidebar-icon">&#8962;</span>
            <span>Home</span>
        </a>

    </nav>

</aside>

<div class="sidebar-backdrop open" id="sidebarBackdrop"></div>


<main class="home-content">

    <h2 class="section-heading">My Subjects</h2>

    <div class="subjects-grid">

        @foreach (var subject in Model.Subjects)
        {
            <div class="subject-card">

                <h3 class="subject-name">
                    @subject.Name.ToUpper()
                </h3>


                <!-- Teacher information -->
                <div class="teacher-info">

                    <!-- Reserved space for teacher's future photo -->
                    <div class="teacher-photo-placeholder"></div>

                    <span class="teacher-name">
                        @subject.TeacherName
                    </span>

                </div>


                <!-- Subject options -->
                <div class="subject-options">

                    @foreach (var option in Model.SubjectOptions)
                    {
                        <button type="button" class="option-item">

                            <!-- Reserved space for future icon -->
                            <span class="option-icon-placeholder"></span>

                            <span class="option-label">
                                @option
                            </span>

                        </button>
                    }

                </div>

            </div>
        }

    </div>

</main>


<script src="~/js/home.js"></script>
 

</body>
</html>
 