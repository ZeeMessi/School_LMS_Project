@page
@model SchoolLMS.Pages.ForgotPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - School LMS</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <main class="login-wrapper">
        <div class="login-card">

            <div class="login-header">
                @if (Model.HasSchoolLogo)
                {
                    <img src="/image/school" alt="School logo" style="width:64px;height:64px;object-fit:contain;border-radius:50%;margin:0 auto 16px;display:block;" />
                }
                else
                {
                    <div class="logo-placeholder">SL</div>
                }
                <h1 class="school-name">Forgot Password?</h1>
                <p class="system-name">Learning Management System</p>
            </div>

            <p style="text-align:center; color:#374151; line-height:1.6; margin-bottom:20px;">
                Self-service password reset isn't available yet. Please
                contact your school's administrator (or IT staff) &mdash;
                they can reset your password for you from the school's
                admin panel.
            </p>

            <a href="/Login" class="sign-in-btn" style="display:block; text-align:center; text-decoration:none;">
                Back to Sign In
            </a>

        </div>
    </main>
</body>
</html>
